  "rules": [
    {
      "id": "claude-sonnet-5-5-sampling-parameters",
      "title": "temperature, top_p and top_k return an error on Claude Sonnet 5.5",
      "provider": "anthropic",
      "apis": [
        "messages"
      ],
      "targets": [
        "claude-sonnet-5-5"
      ],
      "check": "sampling",
      "status": "error",
      "error": null,
      "fix": "Remove `temperature`, `top_p` and `top_k`, and steer the model with prompting instead.",
      "sources": [
        {
          "url": "https://platform.claude.com/docs/en/models/sonnet-5-5/migration-guide#sonnet-46-breaking-changes",
          "quote": "Sampling parameters return an error. Remove `temperature`, `top_p`, and `top_k`."
        }
      ],
      "example": {
        "target": "claude-sonnet-5-5",
        "before": {
          "model": "claude-sonnet-4-5-20250929",
          "max_tokens": 1024,
          "temperature": 0,
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        },
        "after": {
          "model": "claude-sonnet-5-5",
          "max_tokens": 1024,
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        }
      },
      "checked": "2026-11-02"
    },
    {
      "id": "claude-sonnet-5-5-prefill",
      "title": "Assistant message prefill returns a 400 on Claude Sonnet 5.5",
      "provider": "anthropic",
      "apis": [
        "messages"
      ],
      "targets": [
        "claude-sonnet-5-5"
      ],
      "check": "prefill",
      "status": "400",
      "error": "This model does not support assistant message prefill. The conversation must end with a user message.",
      "fix": "End the conversation with a user message. Use structured outputs for output format, the system prompt for preambles, and the user turn for continuations.",
      "sources": [
        {
          "url": "https://platform.claude.com/docs/en/models/sonnet-5-5/migration-guide#migrating-from-sonnet-45",
          "quote": "Claude Sonnet 5.5 rejects a prefilled last assistant turn with a 400 error"
        }
      ],
      "example": {
        "target": "claude-sonnet-5-5",
        "before": {
          "model": "claude-sonnet-4-5-20250929",
          "max_tokens": 1024,
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            },
            {
              "role": "assistant",
              "content": "{"
            }
          ]
        },
        "after": {
          "model": "claude-sonnet-5-5",
          "max_tokens": 1024,
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        }
      },
      "checked": "2026-11-02"
    },
    {
      "id": "claude-sonnet-5-5-forced-tool-choice",
      "title": "tool_choice any or tool returns a 400 on Claude Sonnet 5.5",
      "provider": "anthropic",
      "apis": [
        "messages"
      ],
      "targets": [
        "claude-sonnet-5-5"
      ],
      "check": "forcedToolChoice",
      "status": "400",
      "error": "tool_choice: type \"tool\" and \"any\" are not supported for this model.",
      "fix": "Send `tool_choice: {\"type\": \"auto\"}`, mark the tool `strict: true`, and say in the prompt when to use it. This applies to the token counting endpoint too.",
      "sources": [
        {
          "url": "https://platform.claude.com/docs/en/models/sonnet-5-5/migration-guide#forced-tool-use",
          "quote": "Claude Sonnet 5.5 rejects both with a 400 error, including on the token counting endpoint"
        }
      ],
      "example": {
        "target": "claude-sonnet-5-5",
        "before": {
          "model": "claude-sonnet-4-5-20250929",
          "max_tokens": 1024,
          "tools": [
            {
              "name": "get_invoice",
              "description": "Fetch an invoice",
              "input_schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              }
            }
          ],
          "tool_choice": {
            "type": "tool",
            "name": "get_invoice"
          },
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        },
        "after": {
          "model": "claude-sonnet-5-5",
          "max_tokens": 1024,
          "tools": [
            {
              "name": "get_invoice",
              "description": "Fetch an invoice",
              "input_schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              },
              "strict": true
            }
          ],
          "tool_choice": {
            "type": "auto"
          },
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        }
      },
      "checked": "2026-11-02"
    },
    {
      "id": "claude-sonnet-5-5-thinking-budget",
      "title": "thinking type enabled with budget_tokens returns a 400 on Claude Sonnet 5.5",
      "provider": "anthropic",
      "apis": [
        "messages"
      ],
      "targets": [
        "claude-sonnet-5-5"
      ],
      "check": "thinkingEnabled",
      "status": "400",
      "error": "\"thinking.type.enabled\" is not supported for this model. Use \"thinking.type.adaptive\" and \"output_config.effort\" to control thinking behavior.",
      "fix": "Remove the budget and set an effort level in `output_config.effort`. There's no fixed mapping from budget to effort, so evaluate at two or three levels.",
      "sources": [
        {
          "url": "https://platform.claude.com/docs/en/models/sonnet-5-5/migration-guide#sonnet-46-breaking-changes",
          "quote": "Thinking budgets return an error."
        }
      ],
      "example": {
        "target": "claude-sonnet-5-5",
        "before": {
          "model": "claude-sonnet-4-5-20250929",
          "max_tokens": 16000,
          "thinking": {
            "type": "enabled",
            "budget_tokens": 8000
          },
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        },
        "after": {
          "model": "claude-sonnet-5-5",
          "max_tokens": 16000,
          "thinking": {
            "type": "adaptive"
          },
          "output_config": {
            "effort": "high"
          },
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        }
      },
      "checked": "2026-11-02"
    },
    {
      "id": "claude-sonnet-5-5-thinking-disabled",
      "title": "thinking type disabled returns a 400 on Claude Sonnet 5.5",
      "provider": "anthropic",
      "apis": [
        "messages"
      ],
      "targets": [
        "claude-sonnet-5-5"
      ],
      "check": "thinkingDisabled",
      "status": "400",
      "error": "To turn thinking off on this model, send \"thinking\": {\"type\": \"between_tools\"} instead of {\"type\": \"disabled\"}. The model does not think before responding. The short updates it writes between tool calls come back as thinking blocks.",
      "fix": "Send `thinking: {\"type\": \"between_tools\"}` at `low`, `medium` or `high` effort. At `xhigh` or `max`, use adaptive thinking instead.",
      "sources": [
        {
          "url": "https://platform.claude.com/docs/en/models/sonnet-5-5/migration-guide#turn-off-up-front-thinking",
          "quote": "On Claude Sonnet 5.5, `disabled` returns a 400 `invalid_request_error`"
        }
      ],
      "example": {
        "target": "claude-sonnet-5-5",
        "before": {
          "model": "claude-sonnet-4-5-20250929",
          "max_tokens": 1024,
          "thinking": {
            "type": "disabled"
          },
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        },
        "after": {
          "model": "claude-sonnet-5-5",
          "max_tokens": 1024,
          "thinking": {
            "type": "between_tools"
          },
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        }
      },
      "checked": "2026-11-02"
    },
    {
      "id": "claude-sonnet-5-5-output-format",
      "title": "Top-level output_format returns a 400 on Claude Sonnet 5.5",
      "provider": "anthropic",
      "apis": [
        "messages"
      ],
      "targets": [
        "claude-sonnet-5-5"
      ],
      "check": "outputFormat",
      "status": "400",
      "error": null,
      "fix": "Move the schema to `output_config.format`.",
      "sources": [
        {
          "url": "https://platform.claude.com/docs/en/models/sonnet-5-5/migration-guide#migrating-from-sonnet-45",
          "quote": "The `output_format` parameter is deprecated. To use it anyway, add the `structured-outputs-2025-11-13` beta header. Without it, the API returns a 400 error. Use `output_config.format` instead."
        }
      ],
      "example": {
        "target": "claude-sonnet-5-5",
        "before": {
          "model": "claude-sonnet-4-5-20250929",
          "max_tokens": 1024,
          "output_format": {
            "type": "json_schema",
            "schema": {
              "type": "object"
            }
          },
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        },
        "after": {
          "model": "claude-sonnet-5-5",
          "max_tokens": 1024,
          "output_config": {
            "format": {
              "type": "json_schema",
              "schema": {
                "type": "object"
              }
            }
          },
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        }
      },
      "checked": "2026-11-02"
    },
    {
      "id": "claude-5-5-computer-use-version",
      "title": "computer_20250124 isn't accepted by Claude Sonnet 5.5 or Haiku 5.5",
      "provider": "anthropic",
      "apis": [
        "messages"
      ],
      "targets": [
        "claude-sonnet-5-5",
        "claude-haiku-5-5"
      ],
      "check": "oldComputerTool",
      "status": "400",
      "error": null,
      "fix": "On the Claude API, use the `computer_toolset_20260801` toolset. On Amazon Bedrock, use `computer_20251124`. This needs agent-loop changes, so it isn't auto-fixed.",
      "sources": [
        {
          "url": "https://platform.claude.com/docs/en/models/sonnet-5-5/migration-guide#computer-use-toolset",
          "quote": "Claude Sonnet 5.5 doesn’t accept `computer_20250124` on any platform."
        },
        {
          "url": "https://platform.claude.com/docs/en/models/haiku-5-5/migration-guide",
          "quote": "If you use computer use, replace `computer_20250124`"
        }
      ],
      "example": {
        "target": "claude-sonnet-5-5",
        "manual": true,
        "before": {
          "model": "claude-sonnet-4-5-20250929",
          "max_tokens": 1024,
          "tools": [
            {
              "type": "computer_20250124",
              "name": "computer",
              "display_width_px": 1280,
              "display_height_px": 800
            }
          ],
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        },
        "after": {
          "model": "claude-sonnet-5-5",
          "max_tokens": 1024,
          "tools": [
            {
              "type": "computer_toolset_20260801",
              "name": "computer"
            }
          ],
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        }
      },
      "checked": "2026-11-02"
    },
