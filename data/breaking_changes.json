    {
      "id": "claude-sonnet-5-5-thinking-on-by-default",
      "title": "Claude Sonnet 5.5 thinks by default when thinking is omitted",
      "provider": "anthropic",
      "apis": [
        "messages"
      ],
      "targets": [
        "claude-sonnet-5-5"
      ],
      "check": "thinkingDefault",
      "status": "behavior",
      "error": null,
      "fix": "Read content blocks by `type` (not `content[0].text`), pass thinking blocks back unchanged in tool loops, and revisit `max_tokens`, which covers thinking plus text. To keep running without up-front thinking, send `thinking: {\"type\": \"between_tools\"}`.",
      "sources": [
        {
          "url": "https://platform.claude.com/docs/en/models/sonnet-5-5/migration-guide#thinking-on-by-default",
          "quote": "On Claude Sonnet 5.5, a request with no `thinking` field runs with adaptive thinking"
        }
      ],
      "example": {
        "target": "claude-sonnet-5-5",
        "manual": true,
        "before": {
          "model": "claude-sonnet-4-5-20250929",
          "max_tokens": 1024,
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        },
        "after": {
          "model": "claude-sonnet-5-5",
          "max_tokens": 1024,
          "thinking": {
            "type": "adaptive"
          },
          "messages": [
            {
              "role": "user",
              "content": "Summarize this ticket."
            }
          ]
        }
      },
      "checked": "2026-11-02"
    },
