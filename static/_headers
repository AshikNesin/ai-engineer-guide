# Cloudflare Pages _headers (also read by Netlify-style hosting)
# Reference: https://docs.netlify.com/configure-builds/file-based-configuration/#headers

# Images — long cache (immutable via Cloudinary versioned URLs)
/images/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# CSS/JS files
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable

# Vendored ES modules (fingerprinted; .mjs needs a JavaScript MIME type for module imports)
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/javascript; charset=utf-8

# Favicon and logo
/favicon.ico
  Cache-Control: public, max-age=604800

# Feeds
/feed/*
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex

/feed.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex

/til/feed.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex

# Model retirement feeds (calendar subscription + RSS)
/tools/model-retirements/calendar.ics
  Cache-Control: public, max-age=3600
  Content-Type: text/calendar; charset=utf-8
  X-Robots-Tag: noindex

/tools/model-retirements/feed.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex

# Sitemap
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

# llms.txt — AI agent discoverability
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Reasoning prefix checker + decision converter: pasted requests stay in the
# browser. Only first-party scripts, Umami (hi.nesin.io) and PostHog
# (us.i.posthog.com, us-assets.i.posthog.com) may load or send anything. The newsletter posts
# to buttondown.com, and search fetches /api/search (same origin).
/tools/reasoning-prefix-checker/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://hi.nesin.io https://us-assets.i.posthog.com; connect-src 'self' https://hi.nesin.io https://us.i.posthog.com https://us-assets.i.posthog.com; img-src 'self' data: https://aiengineerguide.com https://res.cloudinary.com; style-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'self' https://buttondown.com; frame-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

/tools/decision-api-converter/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://hi.nesin.io https://us-assets.i.posthog.com; connect-src 'self' https://hi.nesin.io https://us.i.posthog.com https://us-assets.i.posthog.com; img-src 'self' data: https://aiengineerguide.com https://res.cloudinary.com; style-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'self' https://buttondown.com; frame-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

# Default: security headers + short cache for HTML pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cache-Control: public, max-age=0, must-revalidate
