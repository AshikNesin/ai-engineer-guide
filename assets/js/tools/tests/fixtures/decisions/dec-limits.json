{
  "id": "dec-limits",
  "label": "Gemini score with 12 levels to OpenAI",
  "mode": "convert",
  "to": "openai",
  "input": {
    "model": "gemini-decision-1",
    "input": "Rate this essay.",
    "questions": {
      "quality": {
        "type": "score",
        "instructions": "How good is the essay?",
        "criteria": [
          "Level 0: description 0",
          "Level 1: description 1",
          "Level 2: description 2",
          "Level 3: description 3",
          "Level 4: description 4",
          "Level 5: description 5",
          "Level 6: description 6",
          "Level 7: description 7",
          "Level 8: description 8",
          "Level 9: description 9",
          "Level 10: description 10",
          "Level 11: description 11"
        ]
      }
    }
  },
  "expect": {
    "warnings": [
      "score-split",
      "limit-exceeded",
      "model-reset"
    ]
  }
}
